#version 450
#extension GL_EXT_samplerless_texture_functions : require

// Overtime Native v3 motion view (GPU.motion_debug): the velocity pass's motion vectors drawn over a
// dimmed grey copy of the frame. Hue = direction, strength = length (full at pc.full_pixels).
// Source of each pixel (the pass's mask): per-vertex motion grey, camera reprojection blue tint,
// untrusted magenta tint, not covered (no vector written) dark red. Zero motion stays grey.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D color;
layout(set = 0, binding = 1, rg16f) uniform readonly image2D motion;
layout(set = 0, binding = 2, r8) uniform readonly image2D mask;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D staging;

layout(push_constant) uniform Constants {
    uint srgb_target;
    float full_pixels;
} pc;

vec3 SrgbToLinear(vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
}

vec3 LinearToSrgb(vec3 c) {
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

vec3 Hue(float h) {
    const vec3 k = vec3(1.0, 2.0 / 3.0, 1.0 / 3.0);
    return clamp(abs(fract(vec3(h) + k) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
}

void main() {
    const ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 out_size = imageSize(staging);
    if (any(greaterThanEqual(coord, out_size))) {
        return;
    }
    vec3 rgb = texelFetch(color, coord, 0).rgb;
    if (pc.srgb_target != 0u) {
        rgb = LinearToSrgb(clamp(rgb, 0.0, 1.0));
    }
    const float luma = dot(rgb, vec3(0.299, 0.587, 0.114));

    // The motion targets may differ in size from the presented image: nearest texel.
    const ivec2 m_size = imageSize(motion);
    const ivec2 m_coord = clamp(coord * m_size / out_size, ivec2(0), m_size - 1);
    const vec2 mv = imageLoad(motion, m_coord).rg;
    const float source = imageLoad(mask, m_coord).r;

    vec3 base = vec3(0.45 * luma);
    if (source > 0.75) {
        base = vec3(0.30 * luma + 0.10, 0.08 * luma, 0.08 * luma);  // not covered
    } else if (source > 0.375) {
        base = vec3(0.40 * luma + 0.08, 0.20 * luma, 0.40 * luma + 0.08);  // untrusted
    } else if (source > 0.125) {
        base = vec3(0.25 * luma, 0.30 * luma, 0.45 * luma + 0.08);  // camera reprojection
    }
    const float len = length(mv);
    const float strength = clamp(len / max(pc.full_pixels, 1.0), 0.0, 1.0);
    vec3 outc = base;
    if (len > 0.05) {
        const float h = atan(mv.y, mv.x) / 6.2831853 + 0.5;
        outc = mix(base, Hue(h), 0.25 + 0.75 * strength);
    }
    if (pc.srgb_target != 0u) {
        outc = SrgbToLinear(outc);
    }
    imageStore(staging, coord, vec4(outc, 1.0));
}
